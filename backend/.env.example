# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pyrmit

# LLM / AI Gateway
# Use Vercel AI Gateway (preferred) — set AI_GATEWAY_API_KEY
# Fall back to direct OpenAI — set OPENAI_API_KEY
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=

# Mistral (required for PDF OCR)
MISTRAL_API_KEY=

# Auth
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Access gate
ACCESS_GATE_PASSWORD=

# Chat provider override: openai | gateway | openrouter (default: gateway if AI_GATEWAY_API_KEY is set)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=                # OPENROUTER_KEY is accepted too
# LLM_MODEL=openai/gpt-6-luna        # overrides the APP_ENV default below
# LLM_REASONING_EFFORT=xhigh         # reasoning models: answers; query rewrites use LLM_REWRITE_REASONING_EFFORT=low

# Embeddings (defaults = direct OpenAI text-embedding-3-large, 3072 dims).
# Query and stored vectors must come from the same model: after changing these,
# re-embed the target DB with `python chunking/reembed.py --yes` (use a Neon branch).
# EMBEDDING_PROVIDER=openai          # openai | openrouter | local | st
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072
# EMBEDDING_BASE_URL=                # local: http://localhost:11434/v1 (Ollama), TEI, vLLM...
# EMBEDDING_API_KEY=
# EMBEDDING_QUERY_PREFIX=            # e.g. "query: " for E5 models
# EMBEDDING_DOCUMENT_PREFIX=         # e.g. "passage: "

# Retrieval backend for the chat's general RAG path: pgvector (default, Neon) or local
# (offline corpus in data/corpus + local GPU models; see localrag/service.py)
# RETRIEVAL_BACKEND=local
# LOCAL_RAG_MODEL=st-arctic-l-v2
# LOCAL_RAG_MODE=dense               # dense | hybrid | bm25
# LOCAL_RAG_DENSE_QUERY=sv           # en | sv | both
# LOCAL_RAG_RERANKER=BAAI/bge-reranker-v2-m3
# EMBEDDING_RUNTIME=auto             # auto: torch on a CUDA GPU, else ONNX int8 on the CPU | torch | onnx
# HF_HUB_DISABLE_XET=1               # if Hugging Face model downloads hang on Windows

# Agentic chat (tool-calling agent over the local corpus; see agentic/service.py)
# CHAT_MODE=agent
# AGENT_MODEL=openai/gpt-6-luna
# AGENT_EXPLORE_EFFORT=medium        # tool-calling turns (low = faster, less evidence)
# AGENT_EFFORT=medium                # final answer (streamed)
# AGENT_MAX_STEPS=10

# Environment — controls which chat model is used
# development: openai/gpt-5.4-nano
# production:  openai/gpt-5.4-mini
APP_ENV=development

# Deployment (optional)
# ACCESS_GATE_COOKIE_DOMAIN=.yourdomain.com
# ACCESS_GATE_COOKIE_SECURE=true
# ACCESS_GATE_COOKIE_SAMESITE=lax
